# Copy to .env.local (never committed) and fill in from Supabase → Project Settings → API.
# Both are required for production builds (`npm run build` fails without them). The dev server can
# run with both empty (local-only, no sign-in or sync); to build that on purpose, set
# ALLOW_LOCAL_ONLY_BUILD=true.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLISHABLE key (sb_publishable_...) or the legacy "anon" key. It is safe to ship to browsers:
# row-level security limits it to the signed-in user's own rows.
# NEVER put the secret / service_role key here — the build refuses to run if you do.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
