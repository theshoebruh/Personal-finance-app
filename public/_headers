# Cloudflare Pages response headers. The main Content-Security-Policy is a <meta> tag generated at
# build time (it includes the Supabase URL); frame-ancestors only works as a header, so it is here.
/*
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Always check for a new app shell and service worker.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Hashed build assets never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
