# Cloudflare Pages response headers (copied into dist/ by the build).
# The main Content-Security-Policy is a <meta> tag generated at build time because it includes the
# Supabase URL. frame-ancestors only works as a header, so it is set here.
/*
  Content-Security-Policy: frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# The service worker and manifest must be re-checked on every visit so updates reach installed apps.
# (HTML pages, including the index.html served for every app route, already revalidate by default.)
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Hashed build assets never change, so browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
